local function FindDeltaUI()
    local CoreGui = game:GetService("CoreGui")
    for _, gui in pairs(CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            local icon = gui:FindFirstChildWhichIsA("ImageButton", true)
            if icon then
                local stroke = icon:FindFirstChildWhichIsA("UIStroke")
                if stroke and stroke.Thickness == 2 then
                    local settings = gui:FindFirstChild("Settings", true)
                    if settings and settings:FindFirstChild("Holder") then
                        return settings.Holder
                    end
                end
            end
        end
    end
    return nil
end

